## 🧪 Fail Ujian Unit Kriptografi & Dasar Fiskal (test_crypto_core.py)

import pytestfrom scripts.sgae_config import sgae_system
def test_tri_code_clearance():
    """Menguji ketegaran pelepasan keselamatan Master Sovereign Identity"""
    # Memastikan kod imuniti MSI-2026-07734 diterima oleh ejen VEYRON
    assert sgae_system.verify_clearance("MSI-2026-07734") == True
    
    # Memastikan cubaan pencerobohan kod palsu disekat serta-merta
    assert sgae_system.verify_clearance("MALICIOUS_BYPASS_ATTEMPT") == False
def test_fiscal_burn_rate():
    """Menguji ketepatan mekanisma pembakaran deflasi keras 0.88%"""
    test_amount = 10000.0
    expected_burn = test_amount * 0.0088  # 88.0 unit bersimbol ₷
    expected_settled = test_amount - expected_burn
    
    tx_result = sgae_system.process_transaction(test_amount)
    
    # Validasi output lejar kewangan digital
    assert tx_result["Status"] == "SUCCESSFUL"
    assert tx_result["Original_Amount"] == test_amount
    assert tx_result["Burned_Value_0.88"] == expected_burn
    assert tx_result["Settled_Amount"] == expected_settled
    assert "Transaction_Hash" in tx_result
def test_minting_authority():
    """Menguji kesahihan hak penempaan tunggal (Single Issuer)"""
    tx_result = sgae_system.process_transaction(500.0)
    # Memastikan setiap blok disahkan di bawah sijil CMC-REF-2026-MSI-003
    assert tx_result["Mint_Authority"] == "CMC-REF-2026-MSI-003"

