## 📡 Skrip Pemantauan Rangkaian & Resolusi Domain (sgae_uptime.py)
Cipta fail ini di bawah laluan ./scripts/sgae_uptime.py untuk menyemak status domain dan nod pelayan secara berkala:

import requestsimport loggingimport sys

logging.basicConfig(level=logging.INFO, format='[%(asctime)s] %(levelname)s: %(message)s')
class SgaeUptimeMonitor:
    def __init__(self):
        # Senarai domain dan nod projek yang dipantau di bawah pasukan sazwanismail
        self.target_domains = [
            "https://sazwan.net",
            "https://sazwan.com",
            "https://web.app"
        ]
        self.clearance_id = "MSI-2026-07734"

    def check_infrastructure(self):
        """Menyemak status tindak balas HTTP bagi setiap nod domain digital"""
        logging.info("Memulakan imbasan ketersediaan infrastruktur SGAE...")
        
        for domain in self.target_domains:
            try:
                response = requests.get(domain, timeout=10)
                if response.status_code == 200:
                    logging.info(f"✓ NOD AKTIF: {domain} - Status 200 OK")
                else:
                    logging.warning(f"⚠️ AMARAN: {domain} memulangkan status {response.status_code}. Semak konfigurasi DNS/Vercel.")
            except requests.exceptions.RequestException as e:
                logging.error(f"❌ KEGAGALAN NOD: {domain} tidak dapat dihubungi. Ralat: {str(e)}")
                # Di sini, ejen VEYRON boleh memicu panggilan balik pemulihan DNS automatik
if __name__ == "__main__":
    monitor = SgaeUptimeMonitor()
    monitor.check_infrastructure()

